{
  "manifest_version": 3,
  "name": "Zil",
  "version": "1.1.0",
  "description": "YouTube Notification Extension",
  "homepage_url": "https://github.com/Samo-samo/Zil",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://youtube.com/*",
    "https://www.youtube.com/*"
    ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zil",
    "default_icon": {
      "16": "icons/bell-16.png",
      "48": "icons/bell-48.png",
      "128": "icons/bell-128.png"
    }
  },
  "icons": {
    "16": "icons/bell-16.png",
    "48": "icons/bell-48.png",
    "128": "icons/bell-128.png"
  }
}
